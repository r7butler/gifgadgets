FROM python:3.12-slim

WORKDIR /app

# Install test dependencies
RUN pip install --no-cache-dir pytest boto3 "moto[dynamodb,s3]>=5,<6" "fastapi>=0.115,<1" "httpx>=0.27,<1"

# Copy backend code and tests
COPY backend/ backend/
COPY tests/backend/ tests/backend/

# Run tests
ENTRYPOINT ["python", "-m", "pytest", "tests/backend/", "-v"]
