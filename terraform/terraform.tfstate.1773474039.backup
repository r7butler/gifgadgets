    {
      "mode": "managed",
      "type": "aws_cloudfront_function",
      "name": "rewrite_index",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "arn": "arn:aws:cloudfront::759371407688:function/gifwidgets-rewrite-index",
            "code": "function handler(event) {\n  var request = event.request;\n  var uri = request.uri;\n  // Append index.html if URI ends with '/' or has no file extension\n  if (uri.endsWith('/')) {\n    request.uri = uri + 'index.html';\n  } else if (!uri.includes('.', uri.lastIndexOf('/'))) {\n    request.uri = uri + '/index.html';\n  }\n  return request;\n}\n",
            "comment": "Rewrite /path/ and /path to /path/index.html for S3 static site",
            "etag": "ETVPDKIKX0DER",
            "id": "gifwidgets-rewrite-index",
            "key_value_store_associations": null,
            "live_stage_etag": "ETVPDKIKX0DER",
            "name": "gifwidgets-rewrite-index",
            "publish": true,
            "runtime": "cloudfront-js-2.0",
            "status": "UNASSOCIATED"
          },
          "sensitive_attributes": [],
          "identity_schema_version": 0,
